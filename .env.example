# Copy this file to .env for local development. Never commit real secrets.
FABCOPILOT_APP_ENV=development
FABCOPILOT_LOG_LEVEL=INFO

# Local PostgreSQL/pgvector container
POSTGRES_DB=fabcopilot
POSTGRES_USER=fabcopilot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# SQLAlchemy uses Psycopg to connect to PostgreSQL.
FABCOPILOT_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Local Redis cache
REDIS_PASSWORD=change-me
REDIS_PORT=6379
FABCOPILOT_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0
APP_PORT=8000

# Use "fastembed" for real local multilingual semantic retrieval. The first
# run downloads an Apache-2.0 ONNX model. CI can use the deterministic hashing
# provider to remain fast and network-independent.
FABCOPILOT_EMBEDDING_PROVIDER=fastembed
FABCOPILOT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional persistent model directory, mainly useful inside containers.
FABCOPILOT_EMBEDDING_CACHE_DIR=

# Optional shared API key for the portfolio deployment. Production systems
# should replace this with enterprise IAM/RBAC and per-user authorization.
FABCOPILOT_API_KEY=

# Optional: enables the OpenAI Responses API adapter. Keep real keys in .env only.
FABCOPILOT_OPENAI_API_KEY=
FABCOPILOT_OPENAI_MODEL=gpt-5.6-terra
